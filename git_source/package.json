{
  "name": "claude-usage-overlay",
  "version": "1.0.0",
  "description": "Always-on-top widget for monitoring Claude Code token usage",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test-parser": "node test-parser.js",
    "dist": "electron-builder --win",
    "autostart:install": "powershell -ExecutionPolicy Bypass -File install-autostart.ps1",
    "autostart:uninstall": "powershell -ExecutionPolicy Bypass -File uninstall-autostart.ps1"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.claude-usage-overlay",
    "productName": "Claude Usage Overlay",
    "files": [
      "main.js",
      "preload.js",
      "parser.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "ClaudeUsageOverlay.exe"
    }
  }
}
